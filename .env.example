# Obrigatórias
JWT_SECRET=""            # mínimo 16 caracteres (ex.: openssl rand -hex 32)
MONGODB_URL=""           # ex.: mongodb://localhost:27017 (no compose já aponta para o serviço "mongo")

# Opcionais
PORT=3000
OSRM_URL=https://router.project-osrm.org   # vazio = estima distâncias em linha reta (haversine)
SOLVER_TIME_LIMIT=10                       # segundos de busca do OR-Tools por roteirização
PYTHON_BIN=python3                         # no Docker: /opt/venv/bin/python
DEPOT_NOME="Depósito Opt.en"
DEPOT_LAT=-5.843444
DEPOT_LNG=-35.199407
